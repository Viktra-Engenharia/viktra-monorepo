---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/rooftop-hero.png';
import logoUrl from '../assets/logo/white-logo-with-triangle.svg?url';
import { getWhatsAppUrl } from '../data/site';

const whatsappUrl = getWhatsAppUrl('Olá! Gostaria de falar com a Viktra.');
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__image"
    src={heroImage}
    alt="Vista aérea de telhado residencial equipado com painéis solares."
    format="webp"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <img class="hero__logo" src={logoUrl} alt="Viktra" width="1137" height="185" />
    <h1 class="hero__title" id="hero-title">LIBERDADE É PRODUZIR A PRÓPRIA ENERGIA</h1>
    <a class="hero__cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Fale Conosco
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 36rem;
    padding: var(--space-7) var(--page-gutter) 8rem;
    place-items: center;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .hero__image {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .hero__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-color: var(--color-navy);
    opacity: 0.8;
  }

  .hero__content {
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .hero__logo {
    width: min(78vw, 36rem);
    height: auto;
    margin-bottom: var(--space-5);
  }

  .hero__title {
    max-width: 24ch;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.12;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__cta {
    display: inline-flex;
    min-width: 11rem;
    min-height: 3rem;
    margin-top: var(--space-7);
    padding: var(--space-3) var(--space-6);
    align-items: center;
    justify-content: center;
    background-color: var(--color-orange);
    color: var(--color-navy);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.25;
    text-decoration: none;
  }

  .hero__cta:hover {
    background-color: var(--color-white);
  }

  @media (min-width: 768px) {
    .hero {
      min-height: clamp(40rem, 58vw, 50rem);
      padding-block: var(--space-8) 10rem;
    }

    .hero__cta {
      min-width: 17rem;
      min-height: 4rem;
      margin-top: var(--space-8);
      font-size: var(--text-lg);
    }
  }
</style>
