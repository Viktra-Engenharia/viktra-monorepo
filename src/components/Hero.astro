---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/rooftop-hero.png';
import logoUrl from '../assets/logo/white-logo-with-triangle.svg?url';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { getWhatsAppCtaUrl, site } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('hero');
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    widths={[480, 768, 1024, 1440, 1920]}
    sizes="100vw"
    format="webp"
    quality={45}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    <img class="hero__logo" src={logoUrl} alt="Viktra" width="1137" height="185" />
    <p class="hero__kicker">Energia solar em São Carlos e região</p>
    <!-- TODO(conteudo): aprovar o título; combinar com o post/anúncio que leva ao site. -->
    <h1 class="hero__title" id="hero-title">Reduza sua conta de luz com energia solar</h1>
    <p class="hero__lead">
      {site.slogan}. Projeto, instalação e pós-venda feitos por engenheiros, com registro no CREA-SP.
    </p>
    <div class="hero__actions">
      <a
        class="btn-whatsapp hero__cta"
        href={whatsappUrl}
        data-track="whatsapp_click"
        data-track-location="hero"
      >
        <WhatsAppIcon />
        Pedir orçamento no WhatsApp
      </a>
      <a class="hero__secondary" href="#simulador">Simular minha economia</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: 36rem;
    padding: var(--space-7) 0;
    place-items: center;
    overflow: hidden;
    background-color: var(--color-navy);
  }

  .hero__image {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .hero__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-color: var(--color-navy);
    opacity: 0.8;
  }

  .hero__content {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .hero__logo {
    width: min(55vw, 14rem);
    height: auto;
    margin-bottom: var(--space-6);
  }

  .hero__kicker {
    margin: 0 0 var(--space-3);
    color: var(--color-orange);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__title {
    max-width: 18ch;
    margin: 0;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__lead {
    max-width: 38ch;
    margin: var(--space-4) 0 0;
    color: var(--color-white);
    font-size: var(--text-base);
  }

  .hero__actions {
    display: flex;
    width: 100%;
    margin-top: var(--space-6);
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
  }

  .hero__secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .hero__secondary:hover {
    color: var(--color-orange);
  }

  @media (min-width: 640px) {
    .hero__actions {
      width: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-6);
    }
  }

  @media (min-width: 768px) {
    .hero {
      min-height: clamp(40rem, 58vw, 50rem);
      padding-block: var(--space-8);
    }

    .hero__content {
      align-items: center;
      text-align: center;
    }

    .hero__logo {
      width: min(50vw, 26rem);
    }

    .hero__title {
      max-width: 22ch;
      font-size: var(--text-3xl);
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__cta {
      min-height: 3.5rem;
      font-size: var(--text-lg);
    }
  }
</style>
