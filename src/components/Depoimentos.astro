---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import electricalImage from '../assets/images/electrical.webp';
import placeholderImage from '../assets/images/placeholder-red.jpg';
import rooftopImage from '../assets/images/rooftop-hero.png';
import batteryImage from '../assets/images/battery-system.webp';

interface Testimonial {
  name: string;
  city: string;
  text: string;
  photo: ImageMetadata;
  photoAlt: string;
  installationPhoto: ImageMetadata;
  installationPhotoAlt: string;
}

const testimonials: Testimonial[] = [
  {
    name: 'TODO(conteudo): nome do cliente',
    city: 'TODO(conteudo): cidade',
    text: 'TODO(conteudo): inserir depoimento real aprovado.',
    photo: placeholderImage,
    photoAlt: 'Imagem provisória para o retrato do cliente; substituir por foto autorizada.',
    installationPhoto: rooftopImage,
    installationPhotoAlt:
      'Imagem ilustrativa de telhado com painéis solares; substituir por foto autorizada da instalação.',
  },
  {
    name: 'TODO(conteudo): nome do cliente',
    city: 'TODO(conteudo): cidade',
    text: 'TODO(conteudo): inserir depoimento real aprovado.',
    photo: placeholderImage,
    photoAlt: 'Imagem provisória para o retrato do cliente; substituir por foto autorizada.',
    installationPhoto: batteryImage,
    installationPhotoAlt:
      'Imagem ilustrativa de baterias; substituir por foto autorizada da instalação do cliente.',
  },
  {
    name: 'TODO(conteudo): nome do cliente',
    city: 'TODO(conteudo): cidade',
    text: 'TODO(conteudo): inserir depoimento real aprovado.',
    photo: placeholderImage,
    photoAlt: 'Imagem provisória para o retrato do cliente; substituir por foto autorizada.',
    installationPhoto: electricalImage,
    installationPhotoAlt:
      'Imagem ilustrativa de instalação elétrica; substituir por foto autorizada da instalação do cliente.',
  },
];
---

<section
  class="testimonials"
  id="depoimentos"
  aria-labelledby="testimonials-title"
  aria-label="Carrossel de depoimentos de clientes"
>
  <div class="container">
    <h2 class="testimonials__title" id="testimonials-title">
      <span>Nossos Clientes</span>
      <span>— Conheça aqueles que estão conosco</span>
    </h2>

    <div class="testimonials__slides" aria-label="Slides de depoimentos">
      {
        testimonials.map((testimonial, index) => {
          const previousIndex = (index - 1 + testimonials.length) % testimonials.length;
          const nextIndex = (index + 1) % testimonials.length;

          return (
            <article
              class="testimonials__slide"
              id={`depoimento-${index + 1}`}
              tabindex="0"
              role="group"
              aria-roledescription="slide"
              aria-label={`Depoimento ${index + 1} de ${testimonials.length}`}
            >
              <figure class="testimonials__card">
                <div class="testimonials__installation">
                  <Image
                    class="testimonials__installation-image"
                    src={testimonial.installationPhoto}
                    alt={testimonial.installationPhotoAlt}
                    format="webp"
                    loading="lazy"
                  />
                  <nav class="testimonials__controls" aria-label="Navegar pelos depoimentos">
                    <a
                      class="testimonials__control"
                      href={`#depoimento-${previousIndex + 1}`}
                      aria-label={`Depoimento anterior; ir para o slide ${previousIndex + 1}`}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 12H5m7 7-7-7 7-7" />
                      </svg>
                    </a>
                    <a
                      class="testimonials__control"
                      href={`#depoimento-${nextIndex + 1}`}
                      aria-label={`Próximo depoimento; ir para o slide ${nextIndex + 1}`}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14m-7-7 7 7-7 7" />
                      </svg>
                    </a>
                  </nav>
                </div>

                <div class="testimonials__quote-panel">
                  <Image
                    class="testimonials__portrait"
                    src={testimonial.photo}
                    alt={testimonial.photoAlt}
                    format="webp"
                    loading="lazy"
                  />
                  <blockquote class="testimonials__quote">
                    <p>{testimonial.text}</p>
                  </blockquote>
                  <figcaption class="testimonials__caption">
                    <cite>{testimonial.name}</cite>
                    <span>{testimonial.city}</span>
                  </figcaption>
                </div>
              </figure>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-8);
  }

  .testimonials__title {
    position: relative;
    z-index: 1;
    display: grid;
    width: fit-content;
    max-width: 90%;
    margin: 0 0 var(--space-6);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .testimonials__title span + span {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 2vw, 1.5rem);
    line-height: 1.3;
  }

  .testimonials__slides {
    display: grid;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    gap: var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: var(--space-2) var(--space-1) var(--space-5);
    scroll-padding-inline: var(--space-1);
    scroll-snap-type: x mandatory;
  }

  .testimonials__slide {
    min-width: 0;
    scroll-margin-inline: var(--space-1);
    scroll-snap-align: start;
  }

  .testimonials__card {
    position: relative;
    margin: 0;
  }

  .testimonials__installation {
    position: relative;
    aspect-ratio: 16 / 10;
    background-color: var(--color-navy);
  }

  .testimonials__installation-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonials__controls {
    position: absolute;
    inset: 50% var(--space-3) auto;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
  }

  .testimonials__control {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 50%;
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .testimonials__control svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .testimonials__quote-panel {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    align-items: center;
    padding: var(--space-4);
    background-color: var(--color-orange);
    color: var(--color-navy);
  }

  .testimonials__portrait {
    width: 3.5rem;
    height: 3.5rem;
    grid-row: span 2;
    border: 0.2rem solid var(--color-white);
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonials__quote {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .testimonials__quote p {
    margin: 0;
  }

  .testimonials__caption {
    display: grid;
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  .testimonials__caption cite {
    font-style: normal;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .testimonials__title {
      margin-bottom: calc(-1 * var(--space-6));
    }

    .testimonials__slides {
      grid-auto-columns: 100%;
      padding-top: var(--space-7);
    }

    .testimonials__installation {
      aspect-ratio: 16 / 9;
    }

    .testimonials__quote-panel {
      position: absolute;
      right: 8%;
      bottom: 0;
      left: 8%;
      min-height: 9rem;
      padding: var(--space-4) var(--space-5) var(--space-4) 9rem;
    }

    .testimonials__portrait {
      position: absolute;
      top: 50%;
      left: -1.5rem;
      width: 7rem;
      height: 7rem;
      border: 0.25rem solid var(--color-white);
      outline: 0.15rem solid var(--color-orange);
      transform: translateY(-50%);
    }

    .testimonials__quote {
      font-size: var(--text-base);
    }

    .testimonials__caption {
      grid-column: 2;
      grid-template-columns: auto 1fr;
      gap: var(--space-2);
      font-size: var(--text-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__slides {
      scroll-behavior: auto;
      scroll-snap-type: x proximity;
    }
  }
</style>
