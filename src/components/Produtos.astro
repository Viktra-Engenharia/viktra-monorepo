---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import batteryImage from '../assets/images/battery-system.webp';
import electricalImage from '../assets/images/electrical.webp';

interface ProductItem {
  label: string;
  description: string | null;
}

interface ProductGroup {
  title: string;
  theme: 'orange' | 'navy';
  image: ImageMetadata;
  imageAlt: string;
  textAlignment: 'left' | 'right';
  items: ProductItem[];
}

const productGroups: ProductGroup[] = [
  {
    title: 'Sistema de Bateria',
    theme: 'orange',
    image: batteryImage,
    imageAlt: 'Banco de baterias para armazenamento de energia.',
    textAlignment: 'left',
    items: [
      {
        label: 'Off Grid',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
      {
        label: 'Híbrido',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
      {
        label: 'Banco de Bateria',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
    ],
  },
  {
    title: 'Elétrica',
    theme: 'navy',
    image: electricalImage,
    imageAlt: 'Eletricista trabalhando em um painel de automação elétrica.',
    textAlignment: 'right',
    items: [
      {
        label: 'Automação',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
      {
        label: 'Elétrica em Geral',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
      {
        label: 'Projetos Elétricos',
        // TODO(conteudo): substituir pelo texto aprovado, sem publicar o placeholder do mockup.
        description: null,
      },
    ],
  },
];
---

<section class="products" aria-labelledby="products-title">
  <header class="products__header container">
    <h2 class="products__title" id="products-title">Outros Produtos</h2>
    <p class="products__subtitle">
      Saiba onde você pode contar com a Viktra para resolver seus problemas!
    </p>
  </header>

  <div class="products__groups">
    {
      productGroups.map((group) => (
        <article
          class:list={[
            'products__group',
            `products__group--${group.theme}`,
            `products__group--text-${group.textAlignment}`,
          ]}
          aria-labelledby={`products-${group.theme}-title`}
        >
          <Image
            class="products__image"
            src={group.image}
            alt={group.imageAlt}
            format="webp"
            loading="lazy"
          />
          <div class="products__panel">
            <h3 class="products__group-title" id={`products-${group.theme}-title`}>
              {group.title}
            </h3>
            <ul class="products__items">
              {group.items.map((item) => (
                <li class="products__item">
                  <h4 class="products__item-title">{item.label}</h4>
                  {item.description && <p class="products__description">{item.description}</p>}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .products {
    padding-block: var(--space-8);
  }

  .products__header {
    display: grid;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-6);
  }

  .products__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .products__subtitle {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
  }

  .products__groups {
    display: grid;
    gap: var(--space-6);
  }

  .products__group {
    display: grid;
    grid-template-areas:
      'image'
      'panel';
    grid-template-columns: minmax(0, 1fr);
  }

  .products__image {
    grid-area: image;
    width: 100%;
    height: 100%;
    min-height: 14rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .products__panel {
    grid-area: panel;
    padding: var(--space-5) var(--page-gutter);
  }

  .products__group--orange .products__panel {
    background-color: var(--color-orange);
    color: var(--color-navy);
  }

  .products__group--navy .products__panel {
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .products__group-title {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid currentColor;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 7vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .products__items {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .products__item-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }

  .products__description {
    margin: 0;
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .products__header {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      margin-bottom: var(--space-7);
    }

    .products__groups {
      gap: var(--space-7);
    }

    .products__group {
      width: min(100% - var(--page-gutter) * 2, 90rem);
      margin-inline: auto;
      grid-template-areas: 'image panel';
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
      overflow: hidden;
      border-radius: 0.25rem;
      box-shadow: 0 0.5rem 1.5rem rgb(14 30 72 / 12%);
    }

    .products__group--text-right {
      grid-template-areas: 'panel image';
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    }

    .products__image {
      min-height: 100%;
      aspect-ratio: auto;
    }

    .products__panel {
      display: flex;
      min-height: 100%;
      padding: clamp(var(--space-5), 4vw, var(--space-7));
      flex-direction: column;
      justify-content: center;
    }

    .products__group--text-right .products__panel {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .products__group {
      min-height: 24rem;
    }
  }
</style>
