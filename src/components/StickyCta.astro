---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { getWhatsAppCtaUrl } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('sticky');
---

<div class="sticky-cta">
  <a
    class="btn-whatsapp sticky-cta__link"
    href={whatsappUrl}
    data-track="whatsapp_click"
    data-track-location="sticky"
  >
    <WhatsAppIcon />
    Pedir orçamento no WhatsApp
  </a>
</div>

<style>
  /* Mobile only: on wider screens the in-page CTAs are enough. */
  .sticky-cta {
    position: fixed;
    z-index: 10;
    inset: auto 0 0;
    padding: var(--space-2) var(--page-gutter) calc(var(--space-2) + env(safe-area-inset-bottom));
    background-color: var(--color-navy);
    box-shadow: 0 -2px 12px rgb(0 0 0 / 0.2);
  }

  .sticky-cta__link {
    width: 100%;
  }

  .sticky-cta__link:focus-visible {
    outline-color: var(--color-white);
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
