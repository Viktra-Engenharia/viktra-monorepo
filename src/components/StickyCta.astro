---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { getWhatsAppCtaUrl } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('sticky');
---

<div class="sticky-cta">
  <a
    class="btn-whatsapp sticky-cta__link"
    href={whatsappUrl}
    data-track="whatsapp_click"
    data-track-location="sticky"
  >
    <WhatsAppIcon />
    Pedir orçamento no WhatsApp
  </a>
</div>

<script>
  // Hide the bar while the hero (which has the same CTA) is on screen. Without JS it just stays visible.
  const bar = document.querySelector<HTMLElement>('.sticky-cta');
  const hero = document.querySelector('.hero');

  if (bar && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      bar.classList.toggle('sticky-cta--hidden', entry.isIntersecting);
    }).observe(hero);
  }
</script>

<style>
  /* Mobile only: on wider screens the in-page CTAs are enough. */
  .sticky-cta {
    position: fixed;
    z-index: 10;
    inset: auto 0 0;
    padding: var(--space-2) var(--page-gutter) calc(var(--space-2) + env(safe-area-inset-bottom));
    background-color: var(--color-navy);
    box-shadow: 0 -2px 12px rgb(0 0 0 / 0.2);
    transition: transform 0.25s ease;
  }

  .sticky-cta.sticky-cta--hidden {
    transform: translateY(100%);
  }

  /* Keep keyboard users from tabbing into the off-screen bar. */
  .sticky-cta--hidden .sticky-cta__link {
    visibility: hidden;
    transition: visibility 0s 0.25s;
  }

  .sticky-cta__link {
    width: 100%;
  }

  .sticky-cta__link:focus-visible {
    outline-color: var(--color-white);
  }

  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>
