---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { faq, getAnsweredFaq } from '../data/faq';
import { getWhatsAppCtaUrl } from '../data/site';

// In dev, unanswered questions are shown with a TODO so the layout can be reviewed;
// in production only answered ones render (and the section disappears if there are none).
const items = import.meta.env.DEV
  ? faq.map((item) => ({ ...item, answer: item.answer ?? 'TODO(conteudo): resposta pendente.' }))
  : getAnsweredFaq();
const whatsappUrl = getWhatsAppCtaUrl('faq');
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby="faq-title">
      <div class="container faq__inner">
        <h2 class="section-title" id="faq-title">
          Perguntas frequentes
        </h2>

        <div class="faq__list">
          {items.map((item) => (
            <details class="faq__item">
              <summary class="faq__question">{item.question}</summary>
              <p class="faq__answer">{item.answer}</p>
            </details>
          ))}
        </div>

        <p class="faq__more">Ficou com alguma dúvida?</p>
        <a
          class="btn-whatsapp faq__cta"
          href={whatsappUrl}
          data-track="whatsapp_click"
          data-track-location="faq"
        >
          <WhatsAppIcon />
          Perguntar no WhatsApp
        </a>
      </div>
    </section>
  )
}

<style>
  .faq {
    padding-block: var(--space-8);
    background-color: var(--color-white);
  }

  .faq__inner {
    max-width: 50rem;
  }

  .faq__list {
    margin-top: var(--space-6);
    border-top: 2px solid var(--color-navy);
  }

  .faq__item {
    border-bottom: 2px solid var(--color-navy);
  }

  .faq__question {
    display: flex;
    min-height: 3rem;
    padding: var(--space-4) 0;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    font-weight: 700;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  /* Plus sign that turns into a minus when open. */
  .faq__question::after {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    background-color: var(--color-orange);
    color: var(--color-navy);
    font-size: 1.5rem;
    line-height: 1;
    content: "+";
  }

  .faq__item[open] .faq__question::after {
    content: "−";
  }

  .faq__answer {
    margin: 0 0 var(--space-5);
    max-width: 65ch;
  }

  .faq__more {
    margin: var(--space-7) 0 var(--space-3);
    font-weight: 700;
  }

  .faq__cta {
    width: 100%;
  }

  @media (min-width: 640px) {
    .faq__cta {
      width: auto;
    }
  }
</style>
