---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
// The PNG is used as a mask so the icon inherits the parent's text colour (currentColor).
---

<span class:list={['whatsapp-icon', className]} aria-hidden="true"></span>

<style>
  .whatsapp-icon {
    display: inline-block;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    background-color: currentColor;
    -webkit-mask: url('../../assets/icons/whatsapp.png') center / contain no-repeat;
    mask: url('../../assets/icons/whatsapp.png') center / contain no-repeat;
  }
</style>
