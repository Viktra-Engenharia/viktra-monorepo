---
type StepIcon = 'budget' | 'inspection' | 'project' | 'installation' | 'savings';

interface Step {
  label: string;
  icon: StepIcon;
}

const steps: Step[] = [
  { label: 'Orçamento & Proposta', icon: 'budget' },
  { label: 'Vistoria Técnica', icon: 'inspection' },
  { label: 'Projeto & Aprovação', icon: 'project' },
  { label: 'Instalação do Sistema', icon: 'installation' },
  { label: 'Economia', icon: 'savings' },
];
---

<section class="steps" aria-labelledby="steps-title">
  <h2 class="visually-hidden" id="steps-title">Etapas e benefícios</h2>
  <ol class="steps__list container">
    {
      steps.map((step) => (
        <li class:list={['steps__item', { 'steps__item--highlight': step.icon === 'savings' }]}>
          <svg
            class="steps__icon"
            viewBox="0 0 64 64"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {step.icon === 'budget' && (
              <g>
                <path d="M17 8h22l9 9v38H17z" />
                <path d="M39 8v10h9M23 27h19M23 34h11M23 41h7" />
                <rect x="35" y="34" width="16" height="16" rx="1" />
                <path d="M39 38h2m4 0h2m-8 4h2m4 0h2m-8 4h2m4 0h2" />
              </g>
            )}
            {step.icon === 'inspection' && (
              <g>
                <path d="M8 29 34 17l16 5-3 5-13-2-9 5 17 7 11-2 2 5-14 7-25-8-8 4-5-8z" />
                <circle cx="34" cy="31" r="7" />
                <path d="m31 31 2 2 4-5" />
              </g>
            )}
            {step.icon === 'project' && (
              <g>
                <path d="M12 9h30v45H12zM19 18h16M19 25h10" />
                <path d="m28 42 17-17 6 6-17 17-8 2zM42 28l6 6" />
                <path d="M18 54h35" />
              </g>
            )}
            {step.icon === 'installation' && (
              <g>
                <circle cx="45" cy="15" r="7" />
                <path d="M45 3v4m0 16v4M33 15h4m16 0h4m-20-8 3 3m11 11 3 3m0-17-3 3" />
                <path d="m9 33 4-14h26l4 14zM13 25h28M22 19l-3 14m11-14 3 14M7 39h40l4 13H3zM20 39l-2 13m17-13 2 13" />
              </g>
            )}
            {step.icon === 'savings' && (
              <g>
                <circle cx="42" cy="15" r="9" />
                <path d="M42 10v10m3-8h-4a2 2 0 1 0 0 4h2a2 2 0 1 1 0 4h-4M7 37h15l8 5h14a4 4 0 0 1 0 8H29l-9-3H7z" />
                <path d="M7 37v15m0-15h-3v15h3m12-6 10 3" />
              </g>
            )}
          </svg>
          <span class="steps__label">{step.label}</span>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps {
    position: relative;
    z-index: 1;
    margin-top: -5.5rem;
    padding-bottom: var(--space-8);
  }

  .steps__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-block: 0;
    padding-inline: 0;
    list-style: none;
  }

  .steps__item {
    display: flex;
    min-height: 10.5rem;
    padding: var(--space-4) var(--space-2);
    align-items: center;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-3);
    background-color: var(--color-orange);
    color: var(--color-white);
    text-align: center;
  }

  .steps__item--highlight {
    grid-column: 1 / -1;
    min-height: 7rem;
    flex-direction: row;
    background-color: var(--color-navy);
  }

  .steps__icon {
    width: 4rem;
    height: 4rem;
    flex: 0 0 auto;
  }

  .steps__label {
    max-width: 12ch;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .steps__item--highlight .steps__label {
    max-width: none;
    font-size: var(--text-xl);
  }

  @media (min-width: 768px) {
    .steps {
      margin-top: -6rem;
    }

    .steps::before {
      position: absolute;
      z-index: -1;
      top: 5.5rem;
      right: 0;
      left: 0;
      height: 1rem;
      background-color: var(--color-orange);
      content: '';
    }

    .steps__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: clamp(var(--space-3), 3vw, var(--space-7));
    }

    .steps__item,
    .steps__item--highlight {
      grid-column: auto;
      min-height: 13.5rem;
      padding: var(--space-4) var(--space-2);
      flex-direction: column;
    }

    .steps__icon {
      width: 5rem;
      height: 5rem;
    }

    .steps__label {
      max-width: 12ch;
    }

    .steps__item--highlight .steps__label {
      font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    }
  }
</style>
