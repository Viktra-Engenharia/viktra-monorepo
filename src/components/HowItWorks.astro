---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import budgetIcon from '../assets/icons/orcamento-proposta.png';
import inspectionIcon from '../assets/icons/vistoria-tecnica.png';
import projectIcon from '../assets/icons/projeto-aprovacao.png';
import installationIcon from '../assets/icons/instalacao.png';
import savingsIcon from '../assets/icons/economia.png';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { steps, type StepIcon } from '../data/steps';
import { getWhatsAppCtaUrl } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('how-it-works');

const icons: Record<StepIcon, ImageMetadata> = {
  budget: budgetIcon,
  inspection: inspectionIcon,
  project: projectIcon,
  installation: installationIcon,
  savings: savingsIcon,
};
---

<section class="how" aria-labelledby="how-title">
  <div class="container">
    <h2 class="section-title" id="how-title">Como funciona</h2>
    <p class="how__intro">Do primeiro contato à conta mais baixa, a Viktra cuida de tudo.</p>

    <ol class="how__list">
      {
        steps.map((step, index) => (
          <li class:list={['how__item', { 'how__item--highlight': step.icon === 'savings' }]}>
            <div class="how__badge">
              <Image
                class="how__icon"
                src={icons[step.icon]}
                alt=""
                width={80}
                height={80}
                densities={[1, 2]}
                loading="lazy"
              />
            </div>
            <div class="how__text">
              <h3 class="how__title">
                <span class="how__number">{index + 1}.</span> {step.title}
              </h3>
              <p class="how__description">{step.description}</p>
              {step.leadTime && <p class="how__lead-time">Prazo: {step.leadTime}</p>}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="how__actions">
      <a
        class="btn-whatsapp"
        href={whatsappUrl}
        data-track="whatsapp_click"
        data-track-location="how-it-works"
      >
        <WhatsAppIcon />
        Começar pelo orçamento no WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .how {
    --badge-size: 4.5rem;

    padding-block: var(--space-8);
    background-color: var(--color-white);
  }

  .how__intro {
    max-width: 40ch;
    margin: var(--space-4) 0 var(--space-7);
  }

  .how__list {
    position: relative;
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Vertical timeline line joining each badge to the next one on mobile. */
  .how__item:not(:last-child)::before {
    position: absolute;
    top: var(--badge-size);
    bottom: calc(-1 * var(--space-6));
    left: calc(var(--badge-size) / 2 - 0.25rem);
    width: 0.5rem;
    background-color: var(--color-orange);
    content: "";
  }

  .how__item {
    position: relative;
    display: grid;
    grid-template-columns: var(--badge-size) 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .how__badge {
    position: relative;
    z-index: 1;
    display: grid;
    width: var(--badge-size);
    height: var(--badge-size);
    place-items: center;
    background-color: var(--color-orange);
    color: var(--color-white);
  }

  .how__item--highlight .how__badge {
    background-color: var(--color-navy);
  }

  /* Source icons are black line art; invert renders them white on the badges. */
  .how__icon {
    width: 70%;
    height: 70%;
    object-fit: contain;
    filter: invert(1);
  }

  .how__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .how__number {
    color: var(--color-navy);
  }

  .how__description {
    margin: var(--space-2) 0 0;
    font-size: var(--text-sm);
  }

  .how__lead-time {
    display: inline-block;
    margin: var(--space-2) 0 0;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-navy);
    color: var(--color-white);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .how__actions {
    margin-top: var(--space-7);
  }

  .how__actions .btn-whatsapp {
    width: 100%;
  }

  @media (min-width: 640px) {
    .how__actions .btn-whatsapp {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .how {
      --badge-size: 7rem;
    }

    .how__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-5);
    }

    .how__item:not(:last-child)::before {
      content: none;
    }

    /* The mockup's horizontal orange band behind the cards. */
    .how__list::before {
      position: absolute;
      top: calc(var(--badge-size) / 2 - 0.5rem);
      right: 0;
      left: 0;
      height: 1rem;
      background-color: var(--color-orange);
      content: "";
    }

    .how__item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .how__actions {
      text-align: center;
    }
  }
</style>
