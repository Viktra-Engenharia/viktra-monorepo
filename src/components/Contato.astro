---
import logoUrl from '../assets/logo/white-logo-with-triangle.svg?url';
import { getWhatsAppUrl, site } from '../data/site';

const whatsappUrl = getWhatsAppUrl('Olá! Gostaria de falar com a Viktra.');
---

<section class="contact" aria-labelledby="contact-title">
  <div class="contact__layout container">
    <div class="contact__methods">
      <h2 class="contact__heading" id="contact-title">Entre em contato</h2>
      <ul class="contact__list">
        <li>
          <a
            class="contact__link"
            href={site.contact.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Instagram da Viktra, ${site.contact.instagramHandle}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle class="contact__icon-dot" cx="17.5" cy="6.5" r="1" />
            </svg>
            <span>{site.contact.instagramHandle}</span>
          </a>
        </li>
        <li>
          <a class="contact__link" href={`mailto:${site.contact.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="1" />
              <path d="m4 7 8 6 8-6" />
            </svg>
            <span>{site.contact.email}</span>
          </a>
        </li>
        <li>
          <a
            class="contact__link"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`WhatsApp da Viktra: ${site.contact.whatsappNumber}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
              <path d="M9 8.5c.4 2.8 2.1 4.5 4.9 5" />
            </svg>
            <span>{site.contact.whatsappNumber}</span>
          </a>
        </li>
      </ul>
    </div>

    <address class="contact__details">
      <h2 class="contact__heading">Nossos dados</h2>
      <dl class="contact__data">
        <div>
          <dt>CNPJ:</dt>
          <dd>{site.legal.cnpj}</dd>
        </div>
        <div>
          <dt>CREA-SP:</dt>
          <dd>{site.legal.creaSp}</dd>
        </div>
        <div>
          <dt>Endereço:</dt>
          <dd>
            {site.address.streetAddress}, {site.address.locality}, {site.address.region}
          </dd>
        </div>
      </dl>
    </address>

    <div class="contact__brand">
      <img
        class="contact__logo"
        src={logoUrl}
        alt="Viktra"
        width="1137"
        height="185"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-6);
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .contact__layout {
    display: grid;
    gap: var(--space-6);
  }

  .contact__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__link {
    display: flex;
    min-height: 2.75rem;
    padding: var(--space-1) 0;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .contact__link svg {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .contact__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .contact__details {
    min-width: 0;
    font-style: normal;
  }

  .contact__data {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .contact__data div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .contact__data dt {
    font-weight: 700;
  }

  .contact__data dd {
    margin: 0;
  }

  .contact__brand {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact__logo {
    width: min(100%, 17rem);
    height: auto;
  }

  @media (min-width: 768px) {
    .contact__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr);
      gap: var(--space-5);
      align-items: center;
    }

    .contact__logo {
      width: 100%;
    }
  }
</style>
