---
import logoUrl from '../assets/logo/white-logo-with-triangle.svg?url';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { getWhatsAppCtaUrl, site } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('final-cta');
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__band">
    <div class="container final-cta__inner">
      <h2 class="final-cta__title" id="final-cta-title">Pronto para reduzir sua conta de luz?</h2>
      <p class="final-cta__text">
        Mande uma mensagem com o valor da sua conta e receba uma proposta sem compromisso.
      </p>
      <a
        class="btn-whatsapp btn-whatsapp--navy final-cta__button"
        href={whatsappUrl}
        data-track="whatsapp_click"
        data-track-location="final-cta"
      >
        <WhatsAppIcon />
        Pedir orçamento no WhatsApp
      </a>
    </div>
  </div>

  <div class="contact">
    <div class="contact__layout container">
      <div class="contact__methods">
        <h3 class="contact__heading">Entre em contato</h3>
        <ul class="contact__list">
          <li>
            <a
              class="contact__link"
              href={site.contact.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Instagram da Viktra, ${site.contact.instagramHandle}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle class="contact__icon-dot" cx="17.5" cy="6.5" r="1" />
              </svg>
              <span>{site.contact.instagramHandle}</span>
            </a>
          </li>
          <li>
            <a
              class="contact__link"
              href={`mailto:${site.contact.email}`}
              data-track="email_click"
              data-track-location="final-cta"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="1" />
                <path d="m4 7 8 6 8-6" />
              </svg>
              <span>{site.contact.email}</span>
            </a>
          </li>
          <li>
            <a
              class="contact__link"
              href={whatsappUrl}
              data-track="whatsapp_click"
              data-track-location="contact"
              aria-label={`WhatsApp da Viktra: ${site.contact.whatsappNumber}`}
            >
              <span class="contact__icon-box"><WhatsAppIcon /></span>
              <span>{site.contact.whatsappNumber}</span>
            </a>
          </li>
        </ul>
      </div>

      <address class="contact__details">
        <h3 class="contact__heading">Nossos dados</h3>
        <dl class="contact__data">
          <div>
            <dt>CNPJ:</dt>
            <dd>{site.legal.cnpj}</dd>
          </div>
          <div>
            <dt>CREA-SP:</dt>
            <dd>{site.legal.creaSp}</dd>
          </div>
          <div>
            <dt>Endereço:</dt>
            <dd>
              {site.address.streetAddress}, {site.address.locality}, {site.address.region}
            </dd>
          </div>
        </dl>
      </address>

      <div class="contact__brand">
        <img
          class="contact__logo"
          src={logoUrl}
          alt="Viktra"
          width="1137"
          height="185"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  /* On full-height screens the orange band absorbs the extra space; contact stays at the bottom. */
  @media (min-width: 768px) {
    .final-cta {
      grid-template-rows: 1fr auto;
      align-content: stretch;
    }

    .final-cta__band {
      display: grid;
      align-content: center;
    }
  }

  .final-cta__band {
    padding-block: var(--space-8);
    background-color: var(--color-orange);
    color: var(--color-navy);
  }

  .final-cta__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .final-cta__title {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .final-cta__text {
    max-width: 45ch;
    margin: 0;
  }

  .final-cta__button {
    width: 100%;
    margin-top: var(--space-2);
  }

  .final-cta__button:focus-visible {
    outline-color: var(--color-navy);
  }

  @media (min-width: 640px) {
    .final-cta__button {
      width: auto;
      min-height: 3.5rem;
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 768px) {
    .final-cta__inner {
      justify-items: center;
      text-align: center;
    }
  }

  .contact {
    padding-block: var(--space-6);
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .contact__layout {
    display: grid;
    gap: var(--space-6);
  }

  .contact__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .contact__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__link {
    display: flex;
    min-height: 2.75rem;
    padding: var(--space-1) 0;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .contact__link svg {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  /* Same 2rem slot as the outline icons; the filled glyph sits a bit smaller to match their weight. */
  .contact__icon-box {
    display: flex;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }

  .contact__icon-box :global(.whatsapp-icon) {
    width: 1.625rem;
    height: 1.625rem;
  }

  .contact__icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .contact__details {
    min-width: 0;
    font-style: normal;
  }

  .contact__data {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .contact__data div {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .contact__data dt {
    font-weight: 700;
  }

  .contact__data dd {
    margin: 0;
  }

  .contact__brand {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact__logo {
    width: min(100%, 17rem);
    height: auto;
  }

  @media (min-width: 768px) {
    .contact__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr);
      gap: var(--space-5);
      align-items: center;
    }

    .contact__logo {
      width: 100%;
    }
  }
</style>
