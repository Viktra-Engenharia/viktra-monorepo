---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import andreyImage from '../assets/images/founder-andrey.png';
import ricardoImage from '../assets/images/founder-ricardo.png';
import teamImage from '../assets/images/team-viktra.png';

interface Founder {
  name: string;
  role: string;
  education: string;
  image: ImageMetadata;
  instagramUrl: string;
  linkedInUrl: string;
}

const founders: Founder[] = [
  {
    name: 'Andrey Martins',
    role: 'CEO',
    education: 'Engenheiro Mecatrônico — Universidade de São Paulo (USP)',
    image: andreyImage,
    // TODO(conteudo): substituir pelo perfil oficial do Instagram.
    instagramUrl: 'https://www.instagram.com/TODO(conteudo)/',
    // TODO(conteudo): substituir pelo perfil oficial do LinkedIn.
    linkedInUrl: 'https://www.linkedin.com/in/TODO(conteudo)/',
  },
  {
    name: 'Ricardo Peixoto',
    role: 'CTO',
    education: 'Engenheiro Mecatrônico — Universidade de São Paulo (USP)',
    image: ricardoImage,
    // TODO(conteudo): substituir pelo perfil oficial do Instagram.
    instagramUrl: 'https://www.instagram.com/TODO(conteudo)/',
    // TODO(conteudo): substituir pelo perfil oficial do LinkedIn.
    linkedInUrl: 'https://www.linkedin.com/in/TODO(conteudo)/',
  },
];
---

<section class="about" aria-labelledby="about-title">
  <div class="container">
    <header class="about__header">
      <h2 class="about__title" id="about-title">Conheça a Viktra</h2>
      <p class="about__subtitle">
        Saiba onde você pode contar com a Viktra para resolver seus problemas!
      </p>
    </header>

    <div class="about__columns">
      <article class="about__intro" aria-labelledby="about-intro-title">
        <h3 class="about__section-title" id="about-intro-title">
          Bem-vindo à nossa empresa!
        </h3>
        <div class="about__copy">
          <p>
            Somos uma equipe de engenharia apaixonada por tecnologia, dedicada a oferecer soluções
            inovadoras para os nossos clientes.
          </p>
          <p>
            Nosso objetivo é criar produtos e serviços que transformam ideias em realidade.
            Combinamos conhecimento técnico avançado, criatividade e visão empreendedora para
            enfrentar desafios complexos e entregar resultados excepcionais.
          </p>
          <p>
            Além disso, estamos comprometidos em construir relacionamentos duradouros com nossos
            clientes. Acreditamos que a confiança é fundamental, e buscamos entender profundamente
            as metas e objetivos de cada cliente para proporcionar soluções personalizadas e
            resultados excepcionais.
          </p>
        </div>
        <a class="about__testimonials-link" href="#depoimentos">Veja os Depoimentos</a>
      </article>

      <div class="about__team">
        <section class="about__founders" aria-labelledby="founders-title">
          <h3 class="about__section-title" id="founders-title">Nossos Fundadores</h3>
          <ul class="about__founders-list">
            {
              founders.map((founder) => (
                <li class="about__founder">
                  <Image
                    class="about__founder-image"
                    src={founder.image}
                    alt={founder.name}
                    format="webp"
                    loading="lazy"
                  />
                  <div class="about__founder-info">
                    <h4 class="about__founder-name">{founder.name}</h4>
                    <p class="about__founder-role">{founder.role}</p>
                    <p class="about__founder-education">{founder.education}</p>
                    <nav class="about__social-links" aria-label={`Redes sociais de ${founder.name}`}>
                      <a
                        class="about__social-link"
                        href={founder.instagramUrl}
                        aria-label={`Instagram de ${founder.name}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="5" />
                          <circle cx="12" cy="12" r="4" />
                          <circle class="about__social-dot" cx="17.5" cy="6.5" r="1" />
                        </svg>
                      </a>
                      <a
                        class="about__social-link"
                        href={founder.linkedInUrl}
                        aria-label={`LinkedIn de ${founder.name}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="3" y="3" width="18" height="18" rx="2" />
                          <path d="M8 10v7m0-10v.01M12 17v-4a3 3 0 0 1 6 0v4m-6-4v4" />
                        </svg>
                      </a>
                    </nav>
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="about__crew" aria-labelledby="crew-title">
          <h3 class="about__section-title" id="crew-title">Nossa Equipe</h3>
          <div class="about__crew-photo">
            <Image
              class="about__team-image"
              src={teamImage}
              alt="Equipe Viktra reunida, usando uniformes azul-marinho e laranja."
              format="webp"
              loading="lazy"
            />
          </div>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: var(--space-8);
  }

  .about__header {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .about__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .about__subtitle {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .about__columns {
    display: grid;
    gap: var(--space-7);
  }

  .about__intro,
  .about__team {
    min-width: 0;
  }

  .about__section-title {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--color-orange);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.15;
  }

  .about__copy {
    text-align: left;
  }

  .about__copy p {
    margin: 0 0 var(--space-2);
  }

  .about__testimonials-link {
    display: flex;
    width: fit-content;
    min-height: 2.75rem;
    margin: var(--space-5) auto 0;
    padding: var(--space-2) var(--space-5);
    align-items: center;
    justify-content: center;
    background: linear-gradient(90deg, var(--color-orange), var(--color-navy));
    color: var(--color-white);
    font-weight: 700;
    text-align: center;
    text-decoration: none;
  }

  .about__founders-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__founder {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: var(--space-2);
    align-items: center;
  }

  .about__founder-image {
    width: 5.5rem;
    height: 7.5rem;
    object-fit: cover;
    object-position: center top;
  }

  .about__founder-name,
  .about__founder-role,
  .about__founder-education {
    margin: 0;
  }

  .about__founder-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
  }

  .about__founder-role,
  .about__founder-education {
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .about__founder-education {
    margin-top: var(--space-2);
  }

  .about__social-links {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }

  .about__social-link {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }

  .about__social-link svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .about__social-dot {
    fill: currentColor;
    stroke: none;
  }

  .about__crew {
    margin-top: var(--space-6);
  }

  .about__crew .about__section-title {
    width: 78%;
  }

  .about__crew-photo {
    position: relative;
    isolation: isolate;
    margin: 0 var(--space-4) var(--space-4) 0;
  }

  .about__crew-photo::before,
  .about__crew-photo::after {
    position: absolute;
    z-index: -1;
    content: '';
  }

  .about__crew-photo::before {
    inset: -1rem -1rem 2rem 60%;
    background-color: var(--color-navy);
  }

  .about__crew-photo::after {
    inset: 1rem -1rem -1rem 12%;
    background-color: var(--color-orange);
  }

  .about__team-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .about__header {
      margin-bottom: var(--space-7);
    }

    .about__columns {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-7);
    }

    .about__copy {
      text-align: justify;
    }

    .about__testimonials-link {
      margin-top: var(--space-6);
    }
  }
</style>
