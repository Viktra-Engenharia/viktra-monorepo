---
type TimelineIcon = 'monitoring' | 'insurance' | 'support' | 'maintenance' | 'reports';

interface TimelineItem {
  label: string;
  icon: TimelineIcon;
  description: string | null;
  highlight?: boolean;
}

const timelineItems: TimelineItem[] = [
  {
    label: 'Monitoramento',
    icon: 'monitoring',
    // TODO(conteudo): adicionar uma frase curta sobre monitoramento.
    description: null,
  },
  {
    label: 'Acionamento de Seguros',
    icon: 'insurance',
    // TODO(conteudo): adicionar uma frase curta sobre acionamento de seguros.
    description: null,
  },
  {
    label: 'Central de Dúvida',
    icon: 'support',
    // TODO(conteudo): adicionar uma frase curta sobre a central de dúvida.
    description: null,
  },
  {
    label: 'Equipe de Manutenção',
    icon: 'maintenance',
    // TODO(conteudo): adicionar uma frase curta sobre manutenção.
    description: null,
  },
  {
    label: 'Relatórios Mensais',
    icon: 'reports',
    // TODO(conteudo): adicionar uma frase curta sobre os relatórios mensais.
    description: null,
    highlight: true,
  },
];
---

<section class="post-installation" aria-labelledby="post-installation-title">
  <div class="post-installation__content container">
    <div class="post-installation__copy">
      <h2 class="post-installation__title" id="post-installation-title">
        <span>Além da instalação</span>
        <span>— o que vem depois?</span>
      </h2>
      <p class="post-installation__subtitle">Você já se perguntou</p>
      <p class="post-installation__text">
        Após a instalação do seu sistema solar, adentramos à fase mais crucial:
        <strong>o acompanhamento e monitoramento contínuo</strong>. Investir em sistemas solares
        representa um compromisso substancial, e preservar seus direitos, segurança e eficiência da
        geração é essencial. <strong>No mercado,</strong> clientes
        <strong> frequentemente enfrentam prejuízos</strong> devido a complexidades envolvendo
        instaladores, fornecedores, concessionária até erros elétricos residenciais.
        <strong> Aqui na Viktra, garantimos a responsabilidade total.</strong>
      </p>
    </div>

    <ol class="post-installation__timeline">
      {
        timelineItems.map((item) => (
          <li
            class:list={[
              'post-installation__item',
              { 'post-installation__item--highlight': item.highlight },
            ]}
          >
            <span class="post-installation__icon" aria-hidden="true">
              <svg
                viewBox="0 0 64 64"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                {item.icon === 'monitoring' && (
                  <g>
                    <circle cx="27" cy="27" r="15" />
                    <path d="m38 38 14 14m-25-24-9 9 5 5 9-9m-6-4 5 5m10-15h8v8m-8 0 10-10" />
                  </g>
                )}
                {item.icon === 'insurance' && (
                  <g>
                    <path d="m32 7 20 9v14c0 12-8 21-20 27C20 51 12 42 12 30V16z" />
                    <path d="m22 31 7 7 14-16" />
                  </g>
                )}
                {item.icon === 'support' && (
                  <g>
                    <path d="M12 32a20 20 0 0 1 40 0v9a5 5 0 0 1-5 5h-5V29h5m-35 0h5v17h-5a5 5 0 0 1-5-5z" />
                    <path d="M17 29a15 15 0 0 1 30 0M26 34h.1m6 0h.1m6 0h.1M28 47h8" />
                    <circle cx="26" cy="34" r="1" />
                    <circle cx="32" cy="34" r="1" />
                    <circle cx="38" cy="34" r="1" />
                  </g>
                )}
                {item.icon === 'maintenance' && (
                  <g>
                    <path d="M38 12a13 13 0 0 0-17 17L9 41l14 14 12-12a13 13 0 0 0 17-17l-9 9-9-9z" />
                    <path d="m10 15 9 9m-4-13 9 9m7 22 8 8" />
                  </g>
                )}
                {item.icon === 'reports' && (
                  <g>
                    <path d="M18 10h28v44H18zM25 10V6h14v4m-9 12h12m-12 8h12m-12 8h7" />
                    <path d="m36 45 4 4 9-10" />
                  </g>
                )}
              </svg>
            </span>
            <div class="post-installation__item-copy">
              <h3 class="post-installation__item-title">{item.label}</h3>
              {item.description && <p class="post-installation__description">{item.description}</p>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .post-installation {
    padding-block: var(--space-8);
  }

  .post-installation__content {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .post-installation__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .post-installation__title span {
    display: block;
  }

  .post-installation__subtitle {
    margin: var(--space-2) 0 var(--space-5);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .post-installation__text {
    margin: 0;
    text-align: left;
  }

  .post-installation__timeline {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-installation__timeline::before {
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 2rem;
    width: 0.375rem;
    background-color: var(--color-orange);
    content: '';
  }

  .post-installation__item {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-3);
  }

  .post-installation__icon {
    z-index: 1;
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 4rem;
    place-items: center;
    border-radius: 50%;
    background-color: var(--color-orange);
    color: var(--color-white);
  }

  .post-installation__icon svg {
    width: 2.75rem;
    height: 2.75rem;
  }

  .post-installation__item-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }

  .post-installation__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .post-installation__item--highlight .post-installation__icon {
    background-color: var(--color-navy);
  }

  .post-installation__item--highlight .post-installation__item-title {
    color: var(--color-orange);
    font-size: var(--text-xl);
  }

  @media (min-width: 768px) {
    .post-installation__content {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(var(--space-6), 7vw, var(--space-8));
    }

    .post-installation__text {
      text-align: justify;
    }

    .post-installation__timeline {
      gap: var(--space-4);
    }
  }

  @media (min-width: 1024px) {
    .post-installation__icon {
      width: 5rem;
      height: 5rem;
      flex-basis: 5rem;
    }

    .post-installation__icon svg {
      width: 3.5rem;
      height: 3.5rem;
    }

    .post-installation__timeline::before {
      left: 2.3125rem;
    }
  }
</style>
