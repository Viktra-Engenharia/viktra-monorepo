---
import { Image } from 'astro:assets';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { afterSalesItems, otherServices, warranties } from '../data/afterSales';
import { founders } from '../data/team';
import { getWhatsAppCtaUrl } from '../data/site';

const whatsappUrl = getWhatsAppCtaUrl('after-sales');
const lastItemIndex = afterSalesItems.length - 1;
---

<section class="after-sales" aria-labelledby="after-sales-title">
  <div class="container">
    <div class="after-sales__top">
      <div class="after-sales__copy">
        <h2 class="section-title" id="after-sales-title">
          Além da instalação<span class="after-sales__subtitle">O que vem depois?</span>
        </h2>
        <p class="after-sales__text">
          Energia solar é um investimento de longo prazo. No mercado, muitos clientes têm prejuízo com
          problemas entre instalador, fornecedor e distribuidora.{' '}
          <strong>Aqui na Viktra, garantimos a responsabilidade total</strong> e seguimos com você
          depois da instalação.
        </p>

        {
          warranties.length > 0 && (
            <ul class="after-sales__warranties">
              {warranties.map((warranty) => (
                <li>
                  <strong>{warranty.label}:</strong> {warranty.term}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <ul class="after-sales__list">
        {
          afterSalesItems.map((item, index) => (
            <li
              class:list={[
                'after-sales__item',
                { 'after-sales__item--highlight': index === lastItemIndex },
              ]}
            >
              <span class="after-sales__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 64 64"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  {item.icon === 'monitoring' && (
                    <g>
                      <circle cx="27" cy="27" r="15" />
                      <path d="m38 38 14 14m-25-24-9 9 5 5 9-9m-6-4 5 5m10-15h8v8m-8 0 10-10" />
                    </g>
                  )}
                  {item.icon === 'insurance' && (
                    <g>
                      <path d="m32 7 20 9v14c0 12-8 21-20 27C20 51 12 42 12 30V16z" />
                      <path d="m22 31 7 7 14-16" />
                    </g>
                  )}
                  {item.icon === 'support' && (
                    <g>
                      <path d="M12 32a20 20 0 0 1 40 0v9a5 5 0 0 1-5 5h-5V29h5m-35 0h5v17h-5a5 5 0 0 1-5-5z" />
                      <path d="M17 29a15 15 0 0 1 30 0M28 47h8" />
                      <circle cx="26" cy="34" r="1" />
                      <circle cx="32" cy="34" r="1" />
                      <circle cx="38" cy="34" r="1" />
                    </g>
                  )}
                  {item.icon === 'maintenance' && (
                    <g>
                      <path d="M38 12a13 13 0 0 0-17 17L9 41l14 14 12-12a13 13 0 0 0 17-17l-9 9-9-9z" />
                      <path d="m10 15 9 9m-4-13 9 9m7 22 8 8" />
                    </g>
                  )}
                  {item.icon === 'reports' && (
                    <g>
                      <path d="M18 10h28v44H18zM25 10V6h14v4m-9 12h12m-12 8h12m-12 8h7" />
                      <path d="m36 45 4 4 9-10" />
                    </g>
                  )}
                </svg>
              </span>
              <div>
                <h3 class="after-sales__item-title">{item.label}</h3>
                {item.description && <p class="after-sales__description">{item.description}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="after-sales__trust">
      <h3 class="after-sales__trust-title">Quem cuida do seu sistema</h3>
      <ul class="after-sales__founders">
        {
          founders.map((founder) => (
            <li class="after-sales__founder">
              {founder.photo && (
                <Image
                  class="after-sales__founder-photo"
                  src={founder.photo}
                  alt={`Foto de ${founder.name}`}
                  width={192}
                  height={192}
                  densities={[1, 2]}
                  format="webp"
                  loading="lazy"
                />
              )}
              <p class="after-sales__founder-name">{founder.name}</p>
              <p class="after-sales__founder-role">{founder.role}</p>
            </li>
          ))
        }
      </ul>
      <p class="after-sales__about">
        Somos engenheiros mecatrônicos formados pela USP, com registro no CREA-SP e{' '}
        <strong>mais de 150 projetos concluídos</strong>. Entendemos o seu consumo, projetamos o
        sistema certo para você e continuamos ao seu lado depois da instalação.
      </p>
    </div>

    <!-- Attached to the bottom of the navy card, like the mockup's orange bands. -->
    <aside class="after-sales__other" aria-labelledby="other-services-title">
      <h3 class="after-sales__other-title" id="other-services-title">Também fazemos</h3>
      <ul class="after-sales__other-list">
        {
          otherServices.map((service) => (
            <li class="after-sales__other-item">
              <span class="after-sales__other-label">{service.label}</span>
              <span class="after-sales__other-detail">{service.detail}</span>
            </li>
          ))
        }
      </ul>
    </aside>

    <a
      class="btn-whatsapp after-sales__cta"
      href={whatsappUrl}
      data-track="whatsapp_click"
      data-track-location="after-sales"
    >
      <WhatsAppIcon />
      Tirar dúvidas no WhatsApp
    </a>
  </div>
</section>

<style>
  .after-sales {
    padding-block: var(--space-8);
  }

  .after-sales__top {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  .after-sales__subtitle {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-xl);
  }

  .after-sales__text {
    max-width: 55ch;
    margin: var(--space-5) 0 0;
  }

  .after-sales__warranties {
    margin: var(--space-5) 0 0;
    padding-left: var(--space-5);
  }

  .after-sales__list {
    position: relative;
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .after-sales__list::before {
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: calc(2rem - 0.1875rem);
    width: 0.375rem;
    background-color: var(--color-orange);
    content: "";
  }

  .after-sales__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .after-sales__icon {
    z-index: 1;
    display: grid;
    width: 4rem;
    height: 4rem;
    flex: 0 0 4rem;
    place-items: center;
    border-radius: 50%;
    background-color: var(--color-orange);
    color: var(--color-white);
  }

  .after-sales__icon svg {
    width: 2.75rem;
    height: 2.75rem;
  }

  .after-sales__item--highlight .after-sales__icon {
    background-color: var(--color-navy);
  }

  .after-sales__item-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.2;
  }

  .after-sales__description {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .after-sales__trust {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding: var(--space-6) var(--space-5);
    background-color: var(--color-navy);
    color: var(--color-white);
  }

  .after-sales__trust-title {
    margin: 0;
    color: var(--color-orange);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    text-align: center;
    text-transform: uppercase;
  }

  .after-sales__founders {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .after-sales__founder {
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  /* Portraits are already circular (brand ring baked in); radius just trims edge halos. */
  .after-sales__founder-photo {
    width: min(100%, 9rem);
    height: auto;
    aspect-ratio: 1;
    margin-bottom: var(--space-3);
    border-radius: 50%;
  }

  .after-sales__founder-name,
  .after-sales__founder-role {
    margin: 0;
  }

  .after-sales__founder-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .after-sales__founder-role {
    color: var(--color-orange);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
  }


  .after-sales__about {
    margin: 0;
    padding: var(--space-5) 0 0;
    border-top: 2px solid var(--color-orange);
    line-height: 1.6;
  }

  .after-sales__about strong {
    color: var(--color-orange);
  }

  .after-sales__other {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-orange);
    color: var(--color-navy);
  }

  .after-sales__other-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .after-sales__other-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .after-sales__other-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .after-sales__other-label {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
  }

  .after-sales__other-detail {
    font-size: var(--text-xs);
    line-height: 1.3;
  }

  .after-sales__cta {
    width: 100%;
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .after-sales__cta {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .after-sales__top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(var(--space-6), 7vw, var(--space-8));
    }
  }

  @media (min-width: 1024px) {
    .after-sales__trust {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--space-5) var(--space-8);
      padding: var(--space-6) var(--space-7);
    }

    .after-sales__trust-title {
      grid-column: 1 / -1;
      text-align: left;
    }

    .after-sales__founder-photo {
      width: 12rem;
    }

    .after-sales__other {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-6);
      padding: var(--space-5) var(--space-7);
    }

    .after-sales__other-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .after-sales__about {
      padding: 0 0 0 var(--space-6);
      border-top: 0;
      border-left: 2px solid var(--color-orange);
    }
  }
</style>
