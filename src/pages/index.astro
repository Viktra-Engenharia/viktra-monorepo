---
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Depoimentos from '../components/Depoimentos.astro';
import AfterSales from '../components/AfterSales.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Viktra | Energia Solar e Soluções Elétricas em São Carlos"
  description="Conheça a Viktra em São Carlos: energia solar, sistemas de bateria e serviços elétricos com atendimento próximo e soluções sob medida."
>
  <main>
    <Hero />
    <Calculator />
    <HowItWorks />
    <Depoimentos />
    <AfterSales />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
