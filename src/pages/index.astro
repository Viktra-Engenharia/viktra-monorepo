---
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PosInstalacao from '../components/PosInstalacao.astro';
import Produtos from '../components/Produtos.astro';
import Sobre from '../components/Sobre.astro';
import Depoimentos from '../components/Depoimentos.astro';
import OndeEstamos from '../components/OndeEstamos.astro';
import Contato from '../components/Contato.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Viktra | Energia Solar e Soluções Elétricas em São Carlos"
  description="Conheça a Viktra em São Carlos: energia solar, sistemas de bateria e serviços elétricos com atendimento próximo e soluções sob medida."
>
  <main>
    <Hero />
    <Calculator />
    <HowItWorks />
    <Sobre />
    <Depoimentos />
    <PosInstalacao />
    <Produtos />
    <!-- <OndeEstamos /> -->
    <Contato />
  </main>
  <Footer />
  <StickyCta />
</BaseLayout>
