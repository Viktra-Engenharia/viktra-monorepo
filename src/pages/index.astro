---
import Hero from '../components/Hero.astro';
import Calculator from '../components/Calculator.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Depoimentos from '../components/Depoimentos.astro';
import AfterSales from '../components/AfterSales.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Energia Solar em São Carlos | Viktra"
  description="Reduza sua conta de luz com energia solar. Simule sua economia e peça um orçamento pelo WhatsApp. Projeto, instalação e pós-venda em São Carlos, SP e GO."
>
  <main>
    <Hero />
    <Calculator />
    <HowItWorks />
    {/* TODO(conteudo): placeholder section — shown only in dev until real, authorized testimonials exist (Stage 5). */}
    {import.meta.env.DEV && <Depoimentos />}
    <AfterSales />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</BaseLayout>
